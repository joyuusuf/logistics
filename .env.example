# SwiftLogix frontend demo
# No environment variables are required to run the demo.
# The values below are placeholders for future backend and map integration.

# Public app URL (used for absolute links in emails/receipts later)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future map provider. Leave empty to use the built-in simulated route map.
# Supported values when implemented: "google" | "mapbox"
NEXT_PUBLIC_MAP_PROVIDER=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Future API base URL. When set, services in lib/services can be swapped
# from the localStorage mock store to real HTTP calls.
NEXT_PUBLIC_API_BASE_URL=
